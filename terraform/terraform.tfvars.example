# AWS Region and Environment
aws_region   = "ap-south-1"
environment  = "production"
project_name = "tribal-scholarship"

# Sizing for Hackathon Prototype (Under $5/mo, Free Tier $0.00/mo)
# Options: "t3.micro" (1 GB RAM - Free Tier $0.00/mo) | "t3.small" (2 vCPU, 2 GB RAM ~$7.50/mo)
instance_type = "t3.small"
volume_size   = 20

# GitHub Repository to clone
github_repo_url = "https://github.com/Dhruta25/Tribal-scholarship.git"

# MongoDB Atlas URI and Secrets (Fill in your own credentials)
mongodb_uri    = "mongodb+srv://<username>:<password>@cluster0.mongodb.net/sih_scholarship?retryWrites=true&w=majority"
jwt_secret     = "your_super_secret_jwt_key_2026"
gemini_api_key = "your_gemini_api_key"
